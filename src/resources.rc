CAPTION "Third-party software licenses"
FONT 9, "Segoe UI"
BEGIN
END

IDR_APP_LICENSE RCDATA "../LICENSE"
IDR_WTL_LICENSE RCDATA "../third_party/wtl/MS-PL.txt"
IDR_JSON_LICENSE RCDATA "../third_party/nlohmann/LICENSE.MIT"

#include <windows.h>
#include "resources.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APP_ICON ICON "../assets/logo.ico"

IDD_LICENSES DIALOGEX 0, 0, 440, 360
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
